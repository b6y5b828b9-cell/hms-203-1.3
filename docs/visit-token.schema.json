{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hms.example/schemas/visit-token.schema.json",
  "title": "Healthcare Visit Token",
  "type": "object",
  "required": [
    "id",
    "tokenNumber",
    "patientId",
    "patientName",
    "line_items"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable token identifier generated by Reception."
    },
    "tokenNumber": {
      "type": "string"
    },
    "patientId": {
      "type": "string"
    },
    "patientName": {
      "type": "string"
    },
    "patientDetails": {
      "type": "object",
      "properties": {
        "nationalId": {
          "type": "string",
          "description": "Emirates ID verified at check-in."
        }
      },
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": ["Waiting", "In Triage", "In Consultation", "Ready for Treatment", "Completed", "Cancelled"]
    },
    "paymentScheme": {
      "type": "object",
      "properties": {
        "schemeType": {
          "type": "string",
          "enum": ["Insurance", "Self-Pay", "Discount Card", "Corporate", "Package"]
        },
        "insuranceProvider": { "type": "string" },
        "policyNumber": { "type": "string" },
        "network": { "type": "string" },
        "coverageTier": { "type": "string" },
        "coveragePercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "copayPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "copayAmount": { "type": "number", "minimum": 0 },
        "deductibleAmount": { "type": "number", "minimum": 0 },
        "preAuthStatus": {
          "type": "string",
          "enum": ["Approved", "Pending", "Not Required"]
        }
      },
      "required": ["schemeType"],
      "additionalProperties": true
    },
    "currentStage": {
      "type": "string"
    },
    "vitals": {
      "$ref": "#/$defs/vitals"
    },
    "doctorOrders": {
      "$ref": "#/$defs/doctorOrders"
    },
    "nursingNotes": {
      "type": "array",
      "description": "Append-only nurse-authored progress notes scoped to this visit token.",
      "items": {
        "type": "object",
        "required": ["id", "note", "nurseId", "nurseName", "recordedAt"],
        "properties": {
          "id": { "type": "string" },
          "note": { "type": "string", "minLength": 1 },
          "nurseId": { "type": "string" },
          "nurseName": { "type": "string" },
          "recordedAt": { "type": "string", "format": "date-time" },
          "noteType": { "type": "string", "enum": ["Progress", "Discharge"] }
        },
        "additionalProperties": false
      }
    },
    "line_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lineItem"
      }
    },
    "billingSummary": {
      "type": "object",
      "properties": {
        "subtotal": {
          "type": "number",
          "minimum": 0
        },
        "insuranceCoveredAmount": {
          "type": "number",
          "minimum": 0
        },
        "copayOrSelfPayAmount": {
          "type": "number",
          "minimum": 0
        },
        "balanceDue": {
          "type": "number",
          "minimum": 0
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["Pending", "Paid", "Waived", "SETTLED"]
        }
      },
      "additionalProperties": true
    },
    "historyLogs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "timestamp", "action", "actor"],
        "properties": {
          "stage": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "action": { "type": "string" },
          "actor": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "vitals": {
      "type": "object",
      "properties": {
        "bpSystolic": { "type": "number" },
        "bpDiastolic": { "type": "number" },
        "heartRate": { "type": "number" },
        "spO2": { "type": "number" },
        "temperature": {
          "type": "number",
          "description": "Stored in Fahrenheit for compatibility; outpatient nurses enter Celsius and the client converts before saving."
        },
        "respiratoryRate": { "type": "number" },
        "heightCm": { "type": "number", "exclusiveMinimum": 0 },
        "weightKg": { "type": "number", "exclusiveMinimum": 0 },
        "bmi": { "type": "number", "exclusiveMinimum": 0, "description": "Calculated from heightCm and weightKg." },
        "chiefComplaint": { "type": "string" },
        "bloodGlucose": { "type": "number" },
        "painScale": { "type": "number", "minimum": 0, "maximum": 10 },
        "allergyUpdates": { "type": "string", "description": "Token-scoped nurse allergy review or update." },
        "triageLevel": { "type": "string" },
        "nursingNotes": { "type": "string" },
        "nurseName": { "type": "string" },
        "recordedAt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "doctorOrders": {
      "type": "object",
      "properties": {
        "healthSummary": { "type": "string" },
        "chiefComplaint": { "type": "string" },
        "clinicalAssessment": { "type": "string" },
        "soapNotes": {
          "type": "object",
          "properties": {
            "subjective": { "type": "string" },
            "objective": { "type": "string" },
            "assessment": { "type": "string" },
            "plan": { "type": "string" }
          },
          "additionalProperties": false
        },
        "diagnoses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "description"],
            "properties": {
              "code": { "type": "string" },
              "description": { "type": "string" },
              "notes": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "medicationRequests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "sku", "medicationName", "quantity", "unitPrice", "price"],
            "properties": {
              "id": { "type": "string" },
              "sku": { "type": "string", "description": "DDC/drug catalog code." },
              "medicationName": { "type": "string" },
              "quantity": { "type": "number", "exclusiveMinimum": 0 },
              "unitPrice": { "type": "number", "minimum": 0 },
              "price": { "type": "number", "minimum": 0 },
              "dosage": { "type": "string" },
              "duration": { "type": "string" },
              "instructions": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "orderedByDoctorId": { "type": "string" },
        "orderedByDoctorName": { "type": "string" },
        "orderedAt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "lineItem": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "department",
        "quantity",
        "unitPrice",
        "totalPrice",
        "orderedBy",
        "orderedAt",
        "insuranceStatus",
        "fulfillmentStatus"
      ],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["Consultation", "Service", "Lab", "Radiology", "Procedure", "Medication"]
        },
        "name": { "type": "string" },
        "department": { "type": "string" },
        "code": { "type": "string" },
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "unitPrice": { "type": "number", "minimum": 0 },
        "totalPrice": { "type": "number", "minimum": 0 },
        "orderedBy": { "type": "string" },
        "orderedAt": { "type": "string" },
        "insuranceStatus": {
          "type": "string",
          "enum": ["Pending_Auth", "Approved", "Partially_Approved", "Denied", "Cash_Only"],
          "description": "Set only by Insurance Approval from the payer response."
        },
        "insuranceApprovalId": { "type": "string" },
        "insuranceApprovedAmount": { "type": "number", "minimum": 0 },
        "copayAmount": { "type": "number", "minimum": 0 },
        "insuranceRemarks": { "type": "string" },
        "appealRequest": {
          "type": "object",
          "required": ["reason", "requestedBy", "requestedAt"],
          "properties": {
            "reason": { "type": "string", "minLength": 1 },
            "requestedBy": { "type": "string" },
            "requestedAt": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        },
        "paymentOverride": {
          "type": "object",
          "required": ["mode", "reason", "overriddenBy", "overriddenAt"],
          "properties": {
            "mode": { "const": "Self_Pay" },
            "reason": { "type": "string", "minLength": 1 },
            "overriddenBy": { "type": "string" },
            "overriddenAt": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        },
        "fulfillmentStatus": {
          "type": "string",
          "enum": ["Ordered", "In Progress", "Completed", "Dispensed"]
        },
        "executionStatus": {
          "type": "string",
          "enum": ["PENDING_SETTLEMENT", "READY_FOR_EXECUTION", "COMPLETED"]
        },
        "treatmentExecution": {
          "type": "object",
          "required": ["executedAt", "executedBy"],
          "properties": {
            "executedAt": { "type": "string", "format": "date-time" },
            "executedBy": { "type": "string" },
            "executedByName": { "type": "string" },
            "notes": { "type": "string" }
          },
          "additionalProperties": false
        },
        "medicationDetails": {
          "type": "object",
          "properties": {
            "ddcCode": { "type": "string" },
            "dosage": { "type": "string" },
            "duration": { "type": "string" },
            "instructions": { "type": "string" }
          },
          "additionalProperties": false
        },
        "resultPayload": {
          "$ref": "#/$defs/serviceResult"
        }
      },
      "additionalProperties": false
    },
    "serviceResult": {
      "type": "object",
      "required": ["submittedAt", "submittedBy"],
      "properties": {
        "value": { "type": "string" },
        "referenceRange": { "type": "string" },
        "findings": { "type": "string" },
        "impression": { "type": "string" },
        "status": { "type": "string", "enum": ["Normal", "Elevated", "Critical", "Completed"] },
        "submittedAt": { "type": "string", "format": "date-time" },
        "submittedBy": { "type": "string" },
        "acknowledgedAt": { "type": "string", "format": "date-time" },
        "acknowledgedBy": { "type": "string" },
        "reportFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "fileName", "mimeType", "dataUrl"],
            "properties": {
              "id": { "type": "string" },
              "fileName": { "type": "string" },
              "mimeType": { "type": "string", "enum": ["application/pdf", "image/jpeg", "image/png"] },
              "dataUrl": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
